# Crowne ORMS local environment.
# Copy this file to .env.local when a Supabase project is selected.
# Do not commit .env.local. Leave secret values empty in source control.
# SUPABASE_SERVICE_ROLE_KEY is server-only and unused until a documented
# server task requires it. Never prefix it with NEXT_PUBLIC_.
# DATA_SOURCE=demo is for local review only and is rejected in production.

DATA_SOURCE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the publishable key instead if the project uses Supabase's newer key format.
SUPABASE_SERVICE_ROLE_KEY=
